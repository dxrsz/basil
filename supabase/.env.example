# Copy to supabase/.env for `supabase start`, and set the same values as
# secrets on your hosted project (`supabase secrets set --env-file supabase/.env`).
OPENAI_API_KEY=sk-...
# Optional overrides
# OPENAI_TEXT_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_REASONING_EFFORT=minimal

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
